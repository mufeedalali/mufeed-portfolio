# RAG Pipeline Configuration

# Application
APP_NAME="RAG Document Assistant"
APP_VERSION="1.0.0"
DEBUG=False

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=False

# Paths
BASE_DIR=.
UPLOAD_DIR=data/uploads
VECTOR_DB_DIR=data/vector_db

# Document Processing
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Embeddings
EMBEDDING_MODEL=mock
EMBEDDING_DIMENSION=384
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Vector Store
VECTOR_DB_COLLECTION=documents
RETRIEVAL_TOP_K=5

# LLM
LLM_PROVIDER=mock
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# OpenAI (optional, only if using OpenAI)
# OPENAI_API_KEY=sk-...

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
